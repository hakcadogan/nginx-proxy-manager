# Copy to .env and set strong values. Never commit .env.
# REQ-OPS-005

# Container / nginx access-error log timezone ($time_local). Default: Turkey.
TZ=Europe/Istanbul

POSTGRES_USER=nsp
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=nsp

REDIS_PASSWORD=change-me-strong-redis-password

# Random 32+ byte secret for session cookie signing material
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# First-admin bootstrap token (single-use until an admin exists)
BOOTSTRAP_TOKEN=change-me-bootstrap-token

# Public URL of the management UI ( fore SameSite / CSRF origin checks)
PUBLIC_ORIGIN=http://localhost:28080
WEB_PORT=28080

# Config agent shared token (control network only)
CONFIG_AGENT_TOKEN=change-me-config-agent-token

# SSL / ACME (P02)
ACME_EMAIL=admin@example.com
CLOUDFLARE_API_TOKEN=
ACME_USE_MOCK_DNS=false
